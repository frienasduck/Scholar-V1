// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DB_DATABASE_URL")
  directUrl = env("DB_DATABASE_URL_UNPOOLED")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  passwordHash        String
  role                UserRole  @default(USER)
  sessionVersion      Int       @default(1)
  timezone            String    @default("Asia/Kolkata")
  coins               Int       @default(0)
  plusBonusGrantedAt  DateTime?
  currentScholarClass Int       @default(11)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  subscriptions         ScholarSubscription[]
  paymentRequests       ScholarPaymentRequest[]
  reviewedPayments      ScholarPaymentRequest[] @relation("PaymentReviewer")
  approvedSubscriptions ScholarSubscription[]   @relation("SubscriptionApprover")
  usageCounters         UsageCounter[]
  storedFiles           StoredFile[]
  coinLedger            CoinLedger[]
  auditEvents           AuditEvent[]            @relation("AuditActor")
  targetedAuditEvents   AuditEvent[]            @relation("AuditTarget")
  sessions              Session[]
  entitlements          Entitlement[]
  usageEvents           UsageEvent[]
  adImpressions         AdImpression[]
  automationWorkflows   AutomationWorkflow[]
  pushSubscriptions     DevicePushSubscription[]
  masteryRecords        MasteryRecord[]
  practiceAttempts      PracticeAttempt[]
  mistakeRecords        MistakeRecord[]
  revisionItems         RevisionItem[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScholarSubscription {
  id               String    @id @default(cuid())
  userId           String
  planId           String    @default("scholar_plus")
  status           String    @default("active")
  source           String
  paymentRequestId String?   @unique
  startedAt        DateTime  @default(now())
  endsAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  approvedByUserId String?

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy     User?                  @relation("SubscriptionApprover", fields: [approvedByUserId], references: [id])
  paymentRequest ScholarPaymentRequest? @relation(fields: [paymentRequestId], references: [id])
  ledgerEntries  CoinLedger[]

  @@index([userId, status])
}

model ScholarPaymentRequest {
  id                      String    @id
  publicReference         String    @unique
  userId                  String
  planId                  String    @default("scholar_plus")
  currency                String    @default("INR")
  expectedAmountPaise     Int
  regularAmountPaise      Int
  offerApplied            Boolean   @default(false)
  status                  String    @default("created")
  payerName               String?
  transactionReference    String?   @unique
  proofData               Bytes?
  proofMimeType           String?
  proofFileName           String?
  createdAt               DateTime  @default(now())
  checkoutOpenedAt        DateTime?
  proofSubmittedAt        DateTime?
  reviewedAt              DateTime?
  reviewedByUserId        String?
  reviewNote              String?
  internalAdminNote       String?
  approvedSubscriptionId  String?
  expiresAt               DateTime?
  emailNotificationStatus String?
  checkoutEmailSentAt     DateTime?
  proofEmailSentAt        DateTime?
  idempotencyKey          String    @unique
  updatedAt               DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                @relation("PaymentReviewer", fields: [reviewedByUserId], references: [id])
  subscription ScholarSubscription?

  @@index([userId, status])
  @@index([createdAt])
}

model UsageCounter {
  id        String   @id @default(cuid())
  userId    String
  key       String
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, day])
}

model StoredFile {
  id        String    @id @default(cuid())
  clientId  String
  userId    String
  name      String
  mimeType  String
  sizeBytes Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt])
}

model CoinLedger {
  id             String               @id @default(cuid())
  userId         String
  subscriptionId String?
  type           String
  amount         Int
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   ScholarSubscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([userId, type])
}

model AuditEvent {
  id               String   @id @default(cuid())
  eventType        String
  actorUserId      String?
  targetUserId     String?
  paymentRequestId String?
  subscriptionId   String?
  metadataJson     String?
  ipHash           String?
  userAgentSummary String?
  createdAt        DateTime @default(now())
  actor            User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  target           User?    @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([eventType, createdAt])
  @@index([targetUserId, createdAt])
}

model SecurityAttempt {
  id        String   @id @default(cuid())
  key       String
  action    String
  createdAt DateTime @default(now())

  @@index([key, action, createdAt])
}

// ============================================================================
// Scholar V2 platform core (additive — see 20260809000000_v2_platform_core)
// Capability-oriented entitlements. Paid access is account-based and
// server-authoritative; this table is written by billing webhooks, admin
// grants, promotions and legacy migration — never by client callbacks.
// ============================================================================

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  key       String
  source    String // billing | iap | promotion | manual | legacy
  status    String   @default("active") // active | grace | expired | revoked
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, source])
  @@index([userId, status])
  @@index([key, status, endsAt])
}

model UsageEvent {
  id             String   @id @default(cuid())
  userId         String
  feature        String
  idempotencyKey String   @unique
  units          Int      @default(1)
  status         String   @default("reserved") // reserved | consumed | released
  periodDay      String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, status])
  @@index([userId, periodDay])
}

model AdCampaign {
  id                   String   @id @default(cuid())
  key                  String
  placement            String
  provider             String   @default("scholar_house") // scholar_house | external
  enabled              Boolean  @default(true)
  skipAfterSeconds     Int?
  maxImpressionsPerUser Int?    @default(3)
  cooldownMinutes      Int?     @default(20)
  startsAt             DateTime?
  endsAt               DateTime?
  targetingRules       Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  impressions AdImpression[]

  @@unique([key, placement])
  @@index([placement, enabled])
}

model AdImpression {
  id          String    @id @default(cuid())
  campaignId  String
  userId      String?
  placement   String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  skippedAt   DateTime?

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId, startedAt])
  @@index([userId, placement, startedAt])
}

model AutomationWorkflow {
  id          String   @id @default(cuid())
  userId      String
  type        String
  state       String   @default("queued") // queued | running | awaiting_confirmation | completed | failed | cancelled | expired
  source      String   @default("lam")
  input       Json?
  currentStep String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions AutomationAction[]

  @@index([userId, state])
  @@index([state, updatedAt])
}

model AutomationAction {
  id                   String   @id @default(cuid())
  workflowId           String
  actionType           String
  parameters           Json?
  status               String   @default("proposed") // proposed | confirmed | running | completed | failed | cancelled
  confirmationRequired Boolean  @default(false)
  confirmedAt          DateTime?
  idempotencyKey       String   @unique
  createdAt            DateTime @default(now())

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, status])
}

model DevicePushSubscription {
  id                    String   @id @default(cuid())
  userId                String
  endpointHash          String   @unique
  encryptedSubscription Json?
  enabled               Boolean  @default(true)
  lastSeenAt            DateTime @default(now())
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model AnalyticsEvent {
  id                 String   @id @default(cuid())
  anonymousOrUserKey String?
  name               String
  properties         Json?
  occurredAt         DateTime @default(now())

  @@index([name, occurredAt])
  @@index([anonymousOrUserKey, occurredAt])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rolloutPct Int     @default(100)
  updatedAt DateTime @updatedAt
}

// ============================================================================
// Scholar V2.1 — Scholar Intelligence core (additive — see 20260809010000_v2_intelligence_core)
// Evidence → mastery → weak topics → revision queue. The server stores raw
// evidence (PracticeAttempt, MistakeRecord, RevisionItem) and derived mastery
// snapshots (MasteryRecord). Mastery is always recomputed server-side from
// evidence; client state is a rendering convenience only.
// ============================================================================

model MasteryRecord {
  id            String    @id @default(cuid())
  userId        String
  subject       String
  chapter       String?
  topic         String?
  level         String    @default("UNKNOWN") // UNKNOWN | INTRODUCED | LEARNING | DEVELOPING | STRONG | MASTERED | DECAYING
  score         Float     @default(0) // 0..1 recency-weighted estimate
  accuracy      Float?
  evidenceCount Int       @default(0)
  decayed       Boolean   @default(false)
  lastAttemptAt DateTime?
  lastRevisedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, chapter, topic])
  @@index([userId, updatedAt])
}

model PracticeAttempt {
  id            String    @id @default(cuid())
  userId        String
  kind          String // quiz | practice | exam-sim | tutor | flashcard | confidence
  subject       String
  chapter       String?
  topic         String?
  correct       Boolean?
  score         Float?
  total         Int?
  difficulty    String?
  rating        Int? // 1..4 (again/hard/good/easy)
  questionId    String?
  question      String?
  userAnswer    String?
  correctAnswer String?
  explanation   String?
  source        String    @default("quiz")
  occurredAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, subject, occurredAt])
}

model MistakeRecord {
  id            String    @id @default(cuid())
  userId        String
  subject       String
  chapter       String?
  topic         String?
  question      String
  userAnswer    String?
  correctAnswer String?
  explanation   String?
  mistakeType   String    @default("Concept Error")
  originalType  String?
  source        String    @default("quiz")
  resolved      Boolean   @default(false)
  resolvedAt    DateTime?
  occurredAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject, occurredAt])
  @@index([userId, resolved, occurredAt])
}

model RevisionItem {
  id             String    @id @default(cuid())
  userId         String
  subject        String
  chapter        String?
  topic          String?
  kind           String    @default("concept") // concept | mistake | flashcard | formula | question
  title          String
  state          String    @default("NEW") // NEW | LEARNING | REVIEW | MATURE | RELEARNING
  intervalDays   Float     @default(0)
  ease           Float     @default(2.5)
  dueAt          DateTime  @default(now())
  reviewCount    Int       @default(0)
  lapses         Int       @default(0)
  sourceId       String?
  priority       Int       @default(50)
  createdAt      DateTime  @default(now())
  lastReviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, sourceId])
  @@index([userId, dueAt, state])
}

