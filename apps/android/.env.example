# ============================================================================
# Scholar Android — environment
# Copy this file to apps/android/.env and fill in your values.
# (apps/android/.env is gitignored; .env.example is committed.)
# ============================================================================

# Base URL of the existing Scholar backend (the Next.js web app).
# No trailing slash. Never hardcode URLs inside components.
#
# DEV (Metro / debug builds) — pick one:
#   Android emulator  ->  http://10.0.2.2:3000   (host machine's localhost)
#   Physical device   ->  http://192.168.x.x:3000 (your computer's LAN IP;
#                         run the web app with `bun run dev -H 0.0.0.0`)
#
# STANDALONE / RELEASE (embedded at bundle time) — use the DEPLOYED HTTPS URL:
#   https://scholar.yourdomain.com   (replace with the real deployed backend)
#
# NOTE: Debug builds allow cleartext HTTP; release builds require HTTPS.
EXPO_PUBLIC_SCHOLAR_API_URL=http://10.0.2.2:3000
