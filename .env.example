DB_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DB_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
GROQ_STT_MODEL=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
# Optional LAM Live Tutor text routing. Auto uses only configured providers.
GEMINI_TEXT_MODEL=gemini-3.6-flash
NVIDIA_TEXT_API_KEY=
NVIDIA_TEXT_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
AISIG_NVIDIA_API_KEY=
AISIG_NVIDIA_ENDPOINT=
AUTH_SESSION_SECRET="replace-with-at-least-32-random-characters"
# Optional dedicated HMAC key for audit-log IP pseudonyms. If omitted, the
# server uses AUTH_SESSION_SECRET; use at least 32 random characters.
AUDIT_LOG_SALT=
# Public authentication. These are SERVER-ONLY; never prefix with NEXT_PUBLIC_.
# Canonical origin only, without path/query; see PUBLIC_AUTH_IMPLEMENTATION_REPORT.md.
AUTH_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Historical SCHOLAR_PRIVATE_BETA/allowlist variables no longer gate accounts.
DEV_MODE_ENABLED=
DEV_MODE_PASSWORD_HASH=
DEV_MODE_SESSION_SECRET=
# Developer Access (privacy-page entry, server-only). Required to enable
# Developer Access; the feature fails closed when unset. Accepts a plain
# password or a scrypt-encoded hash. NEVER commit the real value.
SCHOLAR_DEVELOPER_ACCESS_PASSWORD=
SUBSCRIPTIONS_ENABLED=
SCHOLAR_PLUS_REGULAR_PRICE_INR=
SCHOLAR_PLUS_OFFER_PRICE_INR=
SCHOLAR_PLUS_OFFER_ENABLED=
SCHOLAR_PLUS_OFFER_LABEL=
SCHOLAR_PLUS_OFFER_END_AT=
SCHOLAR_PLUS_BILLING_INTERVAL=
SCHOLAR_PLUS_DURATION_DAYS=
FREE_STORAGE_LIMIT_MB=
PLUS_STORAGE_LIMIT_MB=
FREE_DAILY_QUIZ_GENERATIONS=
FREE_DAILY_SLIDESHOW_GENERATIONS=
PLUS_DAILY_QUIZ_GENERATIONS=
PLUS_DAILY_SLIDESHOW_GENERATIONS=
SCHOLAR_UPI_QR_ASSET=
# Configure at least one payment destination. Checkout fails closed when both
# values are absent; Scholar contains no built-in recipient fallback.
SCHOLAR_UPI_ID=
SCHOLAR_UPI_PHONE=
SCHOLAR_PAYMENT_RECIPIENT_NAME=
SCHOLAR_ADMIN_PAYMENT_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUBSCRIPTION_PROMPT_OPEN_FREQUENCY=
INSTALL_PROMPT_DISMISS_DAYS=

# ===== Scholar V2 platform core =====
# Billing provider adapter. Only "placeholder" exists today — it returns
# BILLING_NOT_CONFIGURED and NEVER grants Plus. Set when a real provider ships.
BILLING_PROVIDER=placeholder
# Feature flags (optional; code defaults apply when unset). Flags gate rollout
# only — they are never the authorization mechanism.
V2_FLAG_ENTITLEMENTS=true
V2_FLAG_USAGE_LIMITS=true
V2_FLAG_NIGTUBE_ADS=true
V2_FLAG_NIGTUBE_MIDROLL=false
V2_FLAG_STUDY_MUSIC_PROMO=true
V2_FLAG_LAM_AUTOMATION=false
V2_FLAG_OFFLINE_SYNC=false
V2_FLAG_PUSH=false
V2_FLAG_DEVELOPER_MODE=true
